# API the app talks to. Leave empty in development: the Android emulator uses http://10.0.2.2:4000/api/v1
# and the iOS simulator uses http://localhost:4000/api/v1.
# On a real phone use your Mac's Wi-Fi address, e.g. http://192.168.1.10:4000/api/v1
# Staging / production builds must use https.
EXPO_PUBLIC_API_URL=
