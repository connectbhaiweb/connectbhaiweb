# Leave both empty to run on the in-browser demo back end (demo bar visible, OTP 123456).
# Set both to switch the app to Supabase (Auth + PostgreSQL + RPC); the demo bar is then hidden.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Mobile app links (home page "Get the app" section). Leave empty until the apps are live.
NEXT_PUBLIC_PLAY_STORE_URL=
NEXT_PUBLIC_APP_STORE_URL=
# URL the QR code opens (e.g. a smart link that sends Android/iOS to the right store). Falls back to the Play Store URL.
NEXT_PUBLIC_APP_URL=

# ConnectBhai NestJS API (backend/). Used by the live data layer once the frontend is switched to it.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Staging only: password the login screen "Admin" button autofills. Leave empty in production.
NEXT_PUBLIC_STAGING_ADMIN_PW=
